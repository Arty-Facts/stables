/stables
/stab/stab
/stab/stb

# Generated runtime assets — the compiled stab binary and the copied
# ollama/webui templates. Produced by `make assets-common`; never committed.
# The sources are assets/{ollama,webui}/ in the repo.
#
# The contents are ignored but each directory keeps one tracked placeholder:
# internal/assets/assets.go embeds these paths unconditionally, and go:embed
# fails to compile when a pattern matches nothing, so without a placeholder a
# fresh clone cannot build at all.
/internal/assets/files/stab/*
!/internal/assets/files/stab/.gitkeep
/internal/assets/files/ollama/*
!/internal/assets/files/ollama/.gitkeep
/internal/assets/files/webui/*
!/internal/assets/files/webui/.gitkeep
/internal/assets/files/tts/*
!/internal/assets/files/tts/.gitkeep

# Baked personal assets (skills/extensions/models/secrets) — regenerated by
# `make assets`; never committed. The *_gen.go embed declarations carry no
# payload and ARE committed, so a fresh clone builds with either tag.
/internal/assets/files/piagent/
/internal/assets/files/home/

tests/e2e/.e2e-keys/
.stables/

# Listening samples from agent_tools/bench_stretch.py. They exist to be heard,
# not committed.
/.stretch-samples/

# Python bytecode from the agent tools
__pycache__/
*.pyc


# Build output of the vendored Rust TUI.
/tts/tui/target/

# Model weights for the voice stack (Kokoro, Piper, Qwen). Hundreds of MB and
# downloadable — kept on disk, never in this repository's history.
/tts/models/

# Python virtualenvs used while working on the vendored backend. The image
# installs its own dependencies; nothing here is committed.
/agent_venv/
/tts/backend/venv/
